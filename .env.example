APP_NAME="PalayOffs Esports"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Database Configuration (MySQL / PostgreSQL / SQLite)
# If using a single connection string (e.g. Supabase, Neon, TiDB, PlanetScale, Railway, Aiven):
# DATABASE_URL=mysql://user:pass@host:3306/palayoffs?sslmode=require
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=palayoffs
DB_USERNAME=root
DB_PASSWORD=

# Session, Cache & Logs (Serverless / Vercel optimized)
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_STORE=array
LOG_CHANNEL=stderr
LOG_LEVEL=error

# Sanctum Authentication & Stateful Domains
SANCTUM_STATEFUL_DOMAINS="localhost,localhost:3000,127.0.0.1,127.0.0.1:8000"

VITE_APP_NAME="${APP_NAME}"
